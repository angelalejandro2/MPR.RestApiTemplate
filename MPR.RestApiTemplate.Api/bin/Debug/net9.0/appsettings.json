{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "HrConnection": "Data Source=localhost:1521/XEPDB1;User Id=hr;Password=MySecurePassword;" 
  },
  "Security": {
    "Jwt": {
      "Issuer": "internal.bff",
      "Audiences": [
        "hr-bff-api"
      ],
      "SecretKey": "your-256-bit-secret-key-here-make-sure-its-long-enough-for-security"
    },
    "Policies": {
      "canRead": {
        "RequiredPermissions": [ "read" ]
      },
      "canCreate": {
        "RequiredPermissions": [ "create" ]
      },
      "canUpdate": {
        "RequiredPermissions": [ "update" ]
      },
      "canDelete": {
        "RequiredPermissions": [ "delete" ]
      },
      "isAdmin": {
        "RequiredPermissions": [ "admin" ]
      }
    }
  }
}

